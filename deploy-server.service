[Unit]
Description=Manual deployment for system.db.inblackm
Documentation=https://github.com/InblackM/system.db.inblackm
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=-/etc/default/deploy-server
ExecStart=/bin/bash /deploy-server.sh
WorkingDirectory=/www/wwwroot/system.db.inblackm
TimeoutStartSec=infinity
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gamedb-deploy
UMask=0027

# This unit has no [Install] section on purpose. Run it explicitly with:
#   systemctl start deploy-server.service
# Follow output with:
#   journalctl -fu deploy-server.service
