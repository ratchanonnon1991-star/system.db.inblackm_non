# ฐานข้อมูล PostgreSQL หลัก (เก็บ gamedb_users / gamedb_queries / gamedb_connections)
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=inblackm_system
PG_USER=postgres
PG_PASSWORD=

# Feed Social เก็บข้อมูลในฐาน topup_inblackm และรับข้อมูลจาก collector ที่ได้รับอนุญาต
SOCIAL_FEED_DATABASE=topup_inblackm

# GameInfo อ่านข้อมูลเว็บ TopUp (Web ON, ช่องข้อมูลลูกค้า, ราคา/ต้นทุนแพ็กเกจ) ผ่าน connection ชื่อ topup_web
# ในหน้าตั้งค่า Connections (อ่านอย่างเดียว) และลิงก์ไปหลังบ้านเว็บเมื่อต้องแก้ เช่น https://<โดเมนเว็บ>/admin/games
GAMEINFO_TOPUP_ADMIN_URL=
# สุ่มอย่างน้อย 24 ตัวอักษร แล้วส่งเป็น Authorization: Bearer <secret> ไปที่ /api/social-feed/ingest
SOCIAL_FEED_INGEST_SECRET=
# กันแบน: เพดานคอมเมนต์ต่อบัญชีใน 24 ชม. (ค่าเริ่มต้น 40)
SOCIAL_FEED_COMMENT_DAILY_CAP=40
# กันแบน: เว้นระยะขั้นต่ำระหว่างคอมเมนต์ของบัญชีเดียวกัน หน่วยวินาที (ค่าเริ่มต้น 180 = 3 นาที)
SOCIAL_FEED_COMMENT_MIN_GAP_SECONDS=180

# คีย์เซ็น session cookie ของ gamedb เอง (string ยาว ๆ อะไรก็ได้ ไม่ต้องตรงกับระบบอื่น)
SESSION_SECRET=

# Cloudflare Turnstile สำหรับหน้า Login
# เปิดใช้แล้วต้องกำหนดทั้ง Site Key และ Secret Key ไม่เช่นนั้นระบบจะปฏิเสธการ Login แบบ fail-closed
TURNSTILE_ENABLED=true
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=systemdb.inblackm.com,localhost

# คีย์เข้ารหัสรหัสผ่านของ connection ที่เพิ่มผ่านหน้าเว็บ (ตั้งแล้วห้ามเปลี่ยน)
GAMEDB_ENC_KEY=
RUSSIA_CHECK_SESSION_KEY=

# บัญชี admin คนแรก — สร้างอัตโนมัติเมื่อตาราง gamedb_users ยังว่าง
# หลังสร้างสำเร็จแล้วจะลบ 2 บรรทัดนี้ออกก็ได้
GAMEDB_ADMIN_USERNAME=admin
GAMEDB_ADMIN_PASSWORD=

# ไม่บังคับ: CoinGecko keyless ใช้ได้ แต่ Demo key ช่วยเพิ่ม rate limit สำหรับ USDT/THB
COINGECKO_DEMO_API_KEY=

# ระบบ Profit: อ่านอย่างเดียว (SELECT เท่านั้น) จาก Postgres การผลิตอีกตัว (thatsky-main /
# ManangementBackEnd ใช้ connection นี้อยู่แล้ว) สำหรับตาราง sky_gocash_history / codashop_orders /
# system_settings — ห้ามเขียนกลับเข้า DB นี้เด็ดขาด
PROFIT_DATABASE_URL=

# Workforce: connection ฐาน storefront ที่มี orders และ queue_bot_orders
# ใช้บัญชี SELECT-only; แยกจาก PG_* ของ tools และไม่ต้องเปลี่ยนค่า login เดิม
# ไม่ตั้ง: แสดงเว็บเฉพาะงานที่เข้าฐานบอท พร้อมคำเตือนว่าข้อมูล Human ไม่ครบ
WORKFORCE_WEB_DATABASE_URL=

# ไม่บังคับ: อัตราแลกเปลี่ยน USD/THB สำหรับต้นทุน GoCash จาก exchangerate-api.com
# (https://www.exchangerate-api.com/docs/overview) — ไม่ตั้งก็ยังกรอกอัตรามือได้ตามปกติ
EXCHANGERATE_API_KEY=
# iTunes จากชีท: path ไฟล์ key ของ Google service account (ตัวเดียวกับ auto-balance) — ไม่ตั้ง = worker ไม่ทำงาน
ITUNE_SHEETS_CREDENTIALS=
# ไม่บังคับ: ID โฟลเดอร์/ไฟล์ชีท (ค่าเริ่มต้นตาม auto-balance) และ Market Place รายเดือนเพิ่มเติม (คั่นด้วย ,)
ITUNE_SHEET_RUSSIA_FOLDER_ID=
ITUNE_SHEET_PAGE_FOLDER_ID=
ITUNE_SHEET_INBLACKM_FOLDER_ID=
ITUNE_SHEET_MARKETPLACE_IDS=
# ไม่บังคับ: ชีตต้นทางของ GameInfo ("1.1 ข้อมูลเติมเกม UID") สำหรับหน้า "นำเข้าจาก Google Sheet"
# อ่านด้วย service account เดียวกับ ITUNE_SHEETS_CREDENTIALS — ต้องแชร์ชีตให้อีเมลของ service account แบบผู้มีสิทธิ์ดู
GAMEINFO_SOURCE_SHEET_ID=

# Sign in with a TopUp staff account (admin/staff on the TopUp website).
# TOPUP_SSO_SECRET must equal TOOLS_SSO_SECRET on TopUp; TopUp's TOOLS_BASE_URL
# must be this app's public origin (GAMEDB_BASE_URL).
NEXT_PUBLIC_TOPUP_BASE_URL=https://inblackm.com
TOPUP_BASE_URL=https://inblackm.com
TOPUP_SSO_SECRET=
