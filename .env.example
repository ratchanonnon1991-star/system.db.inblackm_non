# ฐานข้อมูล PostgreSQL หลัก (เก็บ gamedb_users / gamedb_queries / gamedb_connections)
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=inblackm_system
PG_USER=postgres
PG_PASSWORD=

# คีย์เซ็น session cookie ของ gamedb เอง (string ยาว ๆ อะไรก็ได้ ไม่ต้องตรงกับระบบอื่น)
SESSION_SECRET=

# คีย์เข้ารหัสรหัสผ่านของ connection ที่เพิ่มผ่านหน้าเว็บ (ตั้งแล้วห้ามเปลี่ยน)
GAMEDB_ENC_KEY=

# บัญชี admin คนแรก — สร้างอัตโนมัติเมื่อตาราง gamedb_users ยังว่าง
# หลังสร้างสำเร็จแล้วจะลบ 2 บรรทัดนี้ออกก็ได้
GAMEDB_ADMIN_USERNAME=admin
GAMEDB_ADMIN_PASSWORD=

# host ที่อนุญาตให้ปุ่ม action ต่อแถวยิง HTTP ไปได้ (คั่นด้วย , ใส่พอร์ตด้วยถ้ามี)
# เว้นว่าง = ปิดฟีเจอร์ปุ่ม action ทั้งหมด ซึ่งเป็นค่าเริ่มต้นที่ปลอดภัย
# ตัวอย่าง: GAMEDB_ACTION_HOSTS=127.0.0.1:3000,bot.internal
GAMEDB_ACTION_HOSTS=
