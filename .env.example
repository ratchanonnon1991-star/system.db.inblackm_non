# ฐานข้อมูล PostgreSQL กลาง (ตัวเดียวกับ inblackm storefront)
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=inblackm_system
PG_USER=postgres
PG_PASSWORD=

# ต้องตรงกับ secret ของ inblackm (SESSION_SECRET หรือ OTP_SECRET ที่ inblackm ใช้เซ็น session)
# เพื่อให้ gamedb ตรวจ cookie "inblackm_session" ใบเดียวกันได้
SESSION_SECRET=

# ลิงก์หน้า login ของ inblackm admin (แสดงเมื่อยังไม่ได้เข้าสู่ระบบ)
NEXT_PUBLIC_INBLACKM_ADMIN_URL=http://localhost:4182/admin/login
