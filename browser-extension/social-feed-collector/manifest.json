{
  "manifest_version": 3,
  "name": "Inblackm Social Feed Collector",
  "version": "1.2.1",
  "description": "ตรวจ session และส่งข้อความจาก Facebook Groups ที่ได้รับอนุญาตเข้า Feed Social",
  "permissions": ["alarms", "browsingData", "cookies", "storage", "tabs"],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://facebook.com/*",
    "https://tools.inblackm.com/*",
    "https://systemdb.inblackm.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://www.facebook.com/*", "https://facebook.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }, {
    "matches": ["https://tools.inblackm.com/*", "https://systemdb.inblackm.com/*", "http://localhost/*", "http://127.0.0.1/*"],
    "js": ["bridge.js"],
    "run_at": "document_idle"
  }],
  "action": { "default_title": "Social Feed Collector", "default_popup": "popup.html" },
  "options_page": "options.html"
}
